---
import { about } from '../data/site';
---
<section id="about" class="section section--alt">
  <div class="container wrap">
    <div class="photo">
      <img
        src="/images/portrait-warm.jpg"
        srcset="/images/portrait-warm-640.jpg 640w, /images/portrait-warm.jpg 1000w"
        sizes="(max-width: 720px) 90vw, 380px"
        width="1000" height="1250" loading="lazy"
        alt="Jesu Sundaramaran in a charcoal suit"
      />
    </div>
    <div class="text">
      <p class="eyebrow">About me</p>
      <h2 class="h2">{about.heading}</h2>
      <div class="body">
        {about.paragraphs.map((para, i) => <p class:list={[{ lead: i === 0 }]}>{para}</p>)}
      </div>
      <a href={about.cta.href} class="text-link cta">{about.cta.label} →</a>
      <dl class="facts">
        {about.facts.map((f) => (
          <div><dt class="muted">{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>
<style>
  .wrap { display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .photo { flex: 0 1 380px; min-width: 0; width: 100%; }
  .photo img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; object-position: 50% 15%; border-radius: 24px; border: 1px solid var(--line); }
  .text { flex: 1 1 520px; min-width: 0; }
  .body { margin: 20px 0 0; }
  .body p { margin: 0 0 14px; color: var(--muted); }
  .body p.lead { color: var(--text); font-size: 1.06em; }
  .cta { display: inline-block; margin-top: 4px; }
  .facts { margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px 32px; }
  dt { font-size: 14px; }
  dd { margin: 0; font-weight: 700; }
  @media (max-width: 720px) {
    .wrap { gap: 24px; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
  }
</style>

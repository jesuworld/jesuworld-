---
import Icon from './Icon.astro';
import { site, socials } from '../data/site';
---
<section id="home" class="container hero">
  <div class="hero__text">
    <p class="hello">Hello, I’m</p>
    <h1>{site.name}</h1>
    <p class="ta tamil-name" lang="ta">{site.nameTamil}</p>
    <p class="roles">
      {site.roles.map((r, i) => <>{i > 0 && <span class="slash"> / </span>}{r}</>)}
    </p>
    <p class="intro muted">{site.intro}</p>
    <div class="ctas">
      <a href="#contact" class="btn btn--primary">Invite me to speak</a>
      {site.cvUrl
        ? <a href={site.cvUrl} class="btn btn--ghost" download><Icon name="download" size={18} />Download CV</a>
        : <a href="#resume" class="btn btn--ghost">View resume</a>}
    </div>
    <div class="socials">
      {socials.map((s) => <a class="chip" href={s.href} rel="noopener">{s.label}</a>)}
    </div>
  </div>
  <div class="hero__photo">
    <div class="frame" aria-hidden="true"></div>
    <img
      src="/images/portrait-mono.jpg"
      srcset="/images/portrait-mono-640.jpg 640w, /images/portrait-mono.jpg 1000w"
      sizes="(max-width: 720px) 90vw, 420px"
      width="1000" height="1250"
      alt="Portrait of Jesu Sundaramaran"
      fetchpriority="high"
    />
    <div class="badge">
      <strong>9+ years</strong>
      <span>serving Tamil communities</span>
    </div>
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 64px; align-items: center; padding-top: 96px; padding-bottom: 80px; }
  .hero__text { flex: 1 1 520px; min-width: 0; }
  .hello { margin: 0 0 12px; font-size: 18px; font-weight: 600; color: var(--accent-text); }
  h1 { margin: 0; font-weight: 800; font-size: clamp(42px, 6.5vw, 80px); line-height: 1.05; letter-spacing: -0.02em; }
  .tamil-name { margin: 10px 0 0; font-size: 20px; color: var(--muted); }
  .roles { margin: 24px 0 0; font-size: 22px; font-weight: 600; }
  .slash { color: var(--accent-text); }
  .intro { margin: 18px 0 0; max-width: 560px; }
  .ctas { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 14px; }
  .socials { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 10px; }
  .hero__photo { flex: 0 1 440px; min-width: 0; width: 100%; position: relative; padding: 0 18px 18px 0; }
  .frame { position: absolute; left: 18px; top: 18px; right: 0; bottom: 0; border-radius: 24px; border: 2px solid var(--accent); }
  .hero__photo img { position: relative; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 24px; border: 1px solid var(--line); }
  .badge { position: absolute; left: -16px; bottom: 48px; padding: 14px 18px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
  .badge strong { display: block; font-size: 24px; line-height: 1.1; color: var(--accent-text); }
  .badge span { font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) {
    .hero { padding-top: 28px; padding-bottom: 44px; gap: 28px; flex-direction: column-reverse; align-items: stretch; }
    .hero__text { flex-basis: auto; }
    .hero__photo { flex-basis: auto; }
    .roles { font-size: 18px; }
    .badge { left: 12px; bottom: 32px; }
    .ctas { flex-direction: column; }
  }
</style>

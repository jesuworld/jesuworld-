---
import type { Book } from '../data/books';
import { series } from '../data/books';
interface Props { book: Book; eager?: boolean }
const { book, eager = false } = Astro.props;
---
<div class="cover">
  {book.cover
    ? <img src={book.cover} alt={`Cover of ${book.title}`} width="1000" height="1500" loading={eager ? 'eager' : 'lazy'} />
    : (
      <div class="fallback" aria-hidden="true">
        <span class="series">{series.name}</span>
        <span class="t">{book.title}</span>
        <span class="n">Book {book.number}</span>
      </div>
    )}
</div>
<style>
  .cover { aspect-ratio: 2 / 3; border-radius: 4px 12px 12px 4px; overflow: hidden; background: var(--surface-2); border: 1px solid var(--line); box-shadow: 0 22px 40px -26px rgba(0, 0, 0, 0.7); }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .fallback { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 18px 16px 18px 20px; border-left: 6px solid var(--accent); }
  .series { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text); }
  .t { font-weight: 800; font-size: 20px; line-height: 1.2; }
  .n { font-size: 12px; color: var(--muted); }
</style>

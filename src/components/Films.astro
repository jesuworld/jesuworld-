---
import Icon from './Icon.astro';
import { featuredFilm as f, films, links } from '../data/site';
const yt = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<section id="films" class="films">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">Films · J Studios</p>
        <h2 class="h2">Stories worth sharing</h2>
      </div>
      <a href={links.studios} class="btn btn--ghost" rel="noopener">Visit thejstudios.com ↗</a>
    </div>

    <article class="feature">
      <div class="feature__media">
        <img src={f.image || yt(f.youtubeId)} alt={`${f.title} still`} loading="lazy" width="480" height="360" />
      </div>
      <div class="feature__body">
        <span class="badge">{f.badge}</span>
        <h3>{f.title}</h3>
        <p class="ta tamil" lang="ta">{f.titleTamil}</p>
        <dl>
          {f.credits.map((c) => <><dt>{c.label}</dt><dd>{c.value}</dd></>)}
        </dl>
        <div class="buttons">
          {f.links.map((l) => (
            <a href={l.href} class:list={['btn', l.primary ? 'btn--primary' : 'btn--ghost']} rel="noopener">
              {l.primary && <Icon name="play" size={16} />}{l.label}
            </a>
          ))}
        </div>
      </div>
    </article>

    <div class="grid">
      {films.map((film) => (
        <a href={film.href} class="film" rel="noopener">
          <div class="thumb">
            {film.image || film.youtubeId
              ? <img src={film.image || yt(film.youtubeId!)} alt="" loading="lazy" width="480" height="360" />
              : <span class="thumb__icon"><Icon name="film" size={44} /></span>}
          </div>
          <div class="film__body">
            <p class="film__title">{film.title} {film.titleTamil && <span class="ta" lang="ta">{film.titleTamil}</span>}</p>
            <p class="role">{film.role}</p>
            <p class="desc">{film.text}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  /* The film section stays dark in both themes, like a screening room. */
  .films {
    --text: #f3f5f8; --muted: #a9b4c4; --line: #22344f; --surface: #101c30; --surface-2: #18294a;
    --btn-bg: #d9b24c; --btn-fg: #0b1424; --accent-text: #e3be5c;
    background: #08101d; color: var(--text); padding: 104px 0;
  }
  .feature { display: flex; flex-wrap: wrap; border-radius: 24px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .feature__media { flex: 1 1 460px; min-height: 340px; background: var(--surface-2); }
  .feature__media img { width: 100%; height: 100%; object-fit: cover; }
  .feature__body { flex: 1 1 440px; min-width: 0; padding: 44px; }
  .badge { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; background: var(--btn-bg); color: var(--btn-fg); }
  h3 { margin: 14px 0 4px; font-weight: 800; font-size: 40px; line-height: 1.1; }
  .tamil { margin: 0 0 20px; font-size: 18px; color: var(--muted); }
  dl { margin: 0 0 28px; display: grid; grid-template-columns: max-content 1fr; gap: 8px 20px; font-size: 15px; }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 600; }
  .buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  .grid { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .film { display: block; text-decoration: none; border-radius: 20px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .film:hover { border-color: var(--btn-bg); }
  .film .thumb { aspect-ratio: 16 / 9; }
  .film__body { padding: 20px 22px 24px; }
  .film__title { margin: 0 0 4px; font-weight: 700; font-size: 20px; }
  .film__title .ta { font-weight: 400; font-size: 16px; color: var(--muted); }
  .role { margin: 0 0 8px; font-size: 14px; font-weight: 600; color: var(--accent-text); }
  .desc { margin: 0; font-size: 15px; color: var(--muted); }
  @media (max-width: 720px) {
    .films { padding: 56px 0; }
    .feature__media { min-height: 220px; flex-basis: 100%; }
    .feature__body { padding: 22px; }
    h3 { font-size: 30px; }
    dl { grid-template-columns: 1fr; gap: 2px; }
    dd { margin-bottom: 8px; }
    .buttons :global(.btn) { flex: 1 1 100%; }
  }
</style>

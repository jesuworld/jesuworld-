---
interface Item { when: string; title: string; text?: string; current?: boolean }
interface Props { heading: string; items: Item[] }
const { heading, items } = Astro.props;
---
<div>
  <h3 class="heading">{heading}</h3>
  <ol class="timeline">
    {items.map((it) => (
      <li class:list={[{ current: it.current }]}>
        <span class="dot" aria-hidden="true"></span>
        <p class="when">{it.when}</p>
        <p class="title">{it.title}</p>
        {it.text && <p class="muted text">{it.text}</p>}
      </li>
    ))}
  </ol>
</div>
<style>
  .heading { margin: 0 0 24px; font-weight: 700; font-size: 22px; }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 26px; border-left: 2px solid var(--line); display: flex; flex-direction: column; gap: 28px; }
  li { position: relative; }
  .dot { position: absolute; left: -35px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--line); border: 3px solid var(--surface); }
  .current .dot { background: var(--accent); }
  .when { margin: 0; display: inline-block; font-size: 13px; font-weight: 700; padding: 3px 12px; border-radius: 999px; background: var(--icon-bg); color: var(--accent-text); }
  .title { margin: 10px 0 2px; font-weight: 700; font-size: 19px; }
  .text { margin: 0; }
</style>

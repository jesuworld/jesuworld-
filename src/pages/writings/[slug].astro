---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Only writings without an external `url` get their own page.
export async function getStaticPaths() {
  const posts = await getCollection('writings', ({ data }) => !data.draft && !data.url);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} | Jesu Sundaramaran`} description={post.data.summary}>
  <Header />
  <main id="main" class="section">
    <article class="container article" lang={post.data.lang}>
      <a href="/writings" class="text-link back">All writings</a>
      <p class="muted meta">{post.data.category} · {date}</p>
      <h1 class:list={[{ 'ta-serif': post.data.lang === 'ta' }]}>{post.data.title}</h1>
      <div class:list={['prose', { 'ta-serif': post.data.lang === 'ta' }]}><Content /></div>
    </article>
  </main>
  <Footer />
</Base>
<style>
  .article { max-width: 760px; }
  .back { display: inline-block; margin-bottom: 32px; }
  .meta { margin: 0 0 8px; font-size: 14px; }
  h1 { margin: 0 0 36px; font-weight: 800; font-size: clamp(34px, 5vw, 52px); line-height: 1.2; }
  .prose { font-size: 19px; line-height: 1.85; }
  .prose.ta-serif { line-height: 2.05; font-size: 18px; }
  .prose :global(a) { color: var(--accent-text); }
</style>

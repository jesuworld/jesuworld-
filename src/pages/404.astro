---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found | Jesu Sundaramaran">
  <Header />
  <main id="main" class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h2">This page doesn’t exist.</h1>
      <p class="muted" style="margin: 16px 0 28px">The link may be old, or the page has moved.</p>
      <a href="/" class="btn btn--primary">Go to the home page</a>
    </div>
  </main>
  <Footer />
</Base>

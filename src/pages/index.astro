---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Resume from '../components/Resume.astro';
import Films from '../components/Films.astro';
import Books from '../components/Books.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
import LatestWritings from '../components/LatestWritings.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Highlights />
    <About />
    <Services />
    <Resume />
    <Books />
    <Films />
    <Portfolio />
    <Testimonials />
    <LatestWritings />
    <Contact />
  </main>
  <Footer />
</Base>

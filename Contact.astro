---
import Icon from './Icon.astro';
import { site, socials } from '../data/site';
---
<section id="contact" class="section">
  <div class="container wrap">
    <div class="intro">
      <p class="eyebrow">Contact</p>
      <h2 class="h2">Let’s work together</h2>
      <p class="muted lead">Speaking invitations, pattimanram, film screenings or community collaborations — I’d love to hear from you.</p>
      <ul class="info">
        <li><span class="icon-tile"><Icon name="mail" size={22} /></span><span><span class="muted label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></span></li>
        <li><span class="icon-tile"><Icon name="pin" size={22} /></span><span><span class="muted label">Location</span>{site.location}</span></li>
      </ul>
      <div class="socials">
        {socials.map((s) => <a class="chip" href={s.href} rel="noopener">{s.label}</a>)}
      </div>
    </div>

    {site.formEndpoint ? (
      <form class="card form" action={site.formEndpoint} method="POST">
        <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field full">
          <label for="c-topic">Topic</label>
          <select id="c-topic" name="topic">
            <option>Speaking / pattimanram</option>
            <option>Film screening</option>
            <option>Community collaboration</option>
            <option>Professional enquiry</option>
          </select>
        </div>
        <div class="field full"><label for="c-msg">Message</label><textarea id="c-msg" name="message" rows="5" required></textarea></div>
        <button type="submit" class="btn btn--primary full">Send message</button>
      </form>
    ) : (
      <div class="card form form--simple">
        <p class="big">Prefer email?</p>
        <p class="muted">Write to me directly and I’ll get back to you.</p>
        <a class="btn btn--primary" href={`mailto:${site.email}`}>Email {site.name.split(' ')[0]}</a>
      </div>
    )}
  </div>
</section>
<style>
  .wrap { display: flex; flex-wrap: wrap; gap: 56px; }
  .intro { flex: 1 1 340px; min-width: 0; }
  .lead { margin: 16px 0 32px; }
  .info { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .info li { display: flex; align-items: center; gap: 16px; }
  .info :global(.icon-tile) { width: 52px; height: 52px; }
  .label { display: block; font-size: 14px; }
  .info a { font-weight: 700; text-decoration: none; }
  .info li > span:last-child { font-weight: 700; }
  .socials { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; }
  .form { flex: 1 1 520px; min-width: 0; padding: 36px; border-radius: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; align-content: start; }
  .form--simple { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; }
  .big { margin: 0; font-weight: 800; font-size: 26px; }
  .form--simple p { margin: 0; }
  .form--simple .btn { margin-top: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .full { grid-column: 1 / -1; }
  label { font-size: 14px; font-weight: 700; }
  input, select, textarea { min-height: 52px; padding: 0 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font: inherit; }
  textarea { padding: 14px 16px; resize: vertical; }
  @media (max-width: 720px) {
    .wrap { gap: 32px; }
    .form { padding: 22px; }
  }
</style>

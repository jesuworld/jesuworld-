---
import { getCollection } from 'astro:content';
import { links } from '../data/site';
const posts = (await getCollection('writings', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<section id="blog" class="section section--alt">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">Writings</p>
        <h2 class="h2">Latest stories</h2>
      </div>
      <a href="/writings" class="text-link">All writings</a>
    </div>
    <div class="grid">
      {posts.map((p) => (
        <a href={p.data.url ?? `/writings/${p.id}`} class="card post" rel={p.data.url ? 'noopener' : undefined}>
          <p class="muted meta">{p.data.category} · {fmt(p.data.date)}</p>
          <p class:list={['title', { 'ta-serif': p.data.lang === 'ta' }]} lang={p.data.lang}>{p.data.title}</p>
          {p.data.transliteration && <p class="muted translit">{p.data.transliteration}</p>}
          <p class="muted summary">{p.data.summary}</p>
        </a>
      ))}
    </div>
    <p class="also muted">More Tamil writing at <a class="text-link" href={links.writings} rel="noopener">myezhuthu.link</a></p>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .post { display: block; padding: 28px; text-decoration: none; background: var(--bg); }
  .post:hover { border-color: var(--accent); }
  .meta { margin: 0 0 10px; font-size: 13px; }
  .title { margin: 0; font-weight: 700; font-size: 22px; line-height: 1.4; }
  .ta-serif { font-weight: 600; }
  .translit { margin: 2px 0 0; font-size: 14px; }
  .summary { margin: 12px 0 0; font-size: 15px; }
  .also { margin: 28px 0 0; font-size: 15px; }
</style>
